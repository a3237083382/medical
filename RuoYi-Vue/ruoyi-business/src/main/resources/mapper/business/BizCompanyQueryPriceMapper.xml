<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.mapper.BizCompanyQueryPriceMapper">

    <resultMap type="com.ruoyi.business.domain.BizCompanyQueryPrice" id="BizCompanyQueryPriceResult">
        <result property="id" column="id"/>
        <result property="companyId" column="company_id"/>
        <result property="companyName" column="company_name"/>
        <result property="queryType" column="query_type"/>
        <result property="queryName" column="query_name"/>
        <result property="hitFee" column="hit_fee"/>
        <result property="noResultFee" column="no_result_fee"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectVo">
        select p.id, p.company_id, c.company_name, p.query_type, p.query_name,
               p.hit_fee, p.no_result_fee, p.status, p.remark,
               p.create_by, p.create_time, p.update_by, p.update_time
        from biz_company_query_price p
        left join biz_insurance_company c on p.company_id = c.id
    </sql>

    <select id="selectBizCompanyQueryPriceById" parameterType="Long" resultMap="BizCompanyQueryPriceResult">
        <include refid="selectVo"/>
        where p.id = #{id}
    </select>

    <select id="selectActivePrice" resultMap="BizCompanyQueryPriceResult">
        <include refid="selectVo"/>
        where p.company_id = #{companyId}
          and p.query_type = #{queryType}
          and p.status = '0'
        limit 1
    </select>

    <select id="selectCompanyPrice" resultMap="BizCompanyQueryPriceResult">
        <include refid="selectVo"/>
        where p.company_id = #{companyId}
          and p.query_type = #{queryType}
        limit 1
    </select>

    <select id="selectBizCompanyQueryPriceList" parameterType="com.ruoyi.business.domain.BizCompanyQueryPrice" resultMap="BizCompanyQueryPriceResult">
        <include refid="selectVo"/>
        <where>
            <if test="companyId != null">and p.company_id = #{companyId}</if>
            <if test="companyName != null and companyName != ''">and c.company_name like concat('%', #{companyName}, '%')</if>
            <if test="queryType != null and queryType != ''">and p.query_type like concat('%', #{queryType}, '%')</if>
            <if test="queryName != null and queryName != ''">and p.query_name like concat('%', #{queryName}, '%')</if>
            <if test="status != null and status != ''">and p.status = #{status}</if>
        </where>
        order by p.company_id asc, p.query_type asc
    </select>

    <insert id="insertBizCompanyQueryPrice" parameterType="com.ruoyi.business.domain.BizCompanyQueryPrice" useGeneratedKeys="true" keyProperty="id">
        insert into biz_company_query_price
            (company_id, query_type, query_name, hit_fee, no_result_fee, status, remark, create_by, create_time)
        values
            (#{companyId}, #{queryType}, #{queryName}, #{hitFee}, #{noResultFee}, #{status}, #{remark}, #{createBy}, sysdate())
    </insert>

    <update id="updateBizCompanyQueryPrice" parameterType="com.ruoyi.business.domain.BizCompanyQueryPrice">
        update biz_company_query_price
        <set>
            <if test="companyId != null">company_id = #{companyId},</if>
            <if test="queryType != null and queryType != ''">query_type = #{queryType},</if>
            <if test="queryName != null and queryName != ''">query_name = #{queryName},</if>
            <if test="hitFee != null">hit_fee = #{hitFee},</if>
            <if test="noResultFee != null">no_result_fee = #{noResultFee},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteBizCompanyQueryPriceByIds" parameterType="String">
        delete from biz_company_query_price where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
