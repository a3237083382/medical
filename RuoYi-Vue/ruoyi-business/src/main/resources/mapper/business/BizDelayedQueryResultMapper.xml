<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.mapper.BizDelayedQueryResultMapper">

    <resultMap type="com.ruoyi.business.domain.BizDelayedQueryResult" id="BizDelayedQueryResultResult">
        <result property="id" column="id"/>
        <result property="requestId" column="request_id"/>
        <result property="rowNo" column="row_no"/>
        <result property="rawJson" column="raw_json"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectByRequestId" parameterType="Long" resultMap="BizDelayedQueryResultResult">
        select id, request_id, row_no, cast(raw_json as char) as raw_json,
               create_by, create_time, update_by, update_time
        from biz_delayed_query_result
        where request_id = #{requestId}
        order by row_no asc, id asc
    </select>

    <delete id="deleteByRequestId" parameterType="Long">
        delete from biz_delayed_query_result where request_id = #{requestId}
    </delete>

    <insert id="insertBizDelayedQueryResult" parameterType="com.ruoyi.business.domain.BizDelayedQueryResult" useGeneratedKeys="true" keyProperty="id">
        insert into biz_delayed_query_result (request_id, row_no, raw_json, create_by, create_time)
        values (#{requestId}, #{rowNo}, #{rawJson}, #{createBy}, sysdate())
    </insert>
</mapper>
